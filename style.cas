* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  min-height: 100vh;

  background:
    linear-gradient(
      135deg,
      #eaf4ff,
      #ffffff,
      #eef7ff
    );

  color: #222;
}


/* HEADER */

header {
  width: 100%;
  padding: 18px 5%;

  background: rgba(255,255,255,0.97);

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-shadow: 0 5px 25px rgba(0,0,0,0.10);

  position: sticky;
  top: 0;

  z-index: 1000;
}


.logo {
  font-size: 24px;
  font-weight: bold;
  color: #087cff;
  letter-spacing: 1px;
}


.menu-btn {
  background: #087cff;
  color: white;

  border: none;

  padding: 10px 14px;

  font-size: 23px;

  border-radius: 9px;

  cursor: pointer;
}


/* MENU */

nav {
  display: none;

  position: absolute;

  right: 5%;
  top: 72px;

  width: 230px;

  background: white;

  border-radius: 14px;

  overflow: hidden;

  box-shadow:
    0 10px 35px rgba(0,0,0,0.18);
}


nav.show {
  display: block;
}


nav a {
  display: block;

  padding: 16px 20px;

  color: #222;

  text-decoration: none;

  font-weight: bold;

  transition: 0.3s;
}


nav a:hover {
  background: #087cff;
  color: white;
}


/* MAIN */

main {
  min-height: 70vh;
}


.page {
  display: none;

  min-height: 65vh;

  padding: 70px 20px;

  justify-content: center;
  align-items: center;
}


.page.active {
  display: flex;
}


/* HOME */

.welcome-box {
  width: 100%;
  max-width: 900px;

  text-align: center;
}


.welcome-box h1 {
  font-size: clamp(42px, 8vw, 90px);

  color: #087cff;

  letter-spacing: 3px;

  text-shadow:
    0 5px 20px rgba(8,124,255,0.20);
}


.welcome-box p {
  margin-top: 15px;

  font-size: 20px;

  color: #555;
}


/* HOME BUTTONS */

.home-buttons {
  margin-top: 40px;

  display: flex;

  justify-content: center;

  gap: 15px;

  flex-wrap: wrap;
}


.home-buttons button {
  border: none;

  padding: 15px 28px;

  border-radius: 30px;

  background: #087cff;

  color: white;

  font-size: 16px;

  font-weight: bold;

  cursor: pointer;

  transition: 0.3s;
}


.home-buttons button:hover {
  transform: translateY(-4px);

  box-shadow:
    0 10px 25px rgba(8,124,255,0.35);
}


/* CARDS */

.card,
.message-card {
  width: 100%;

  max-width: 650px;

  background: white;

  padding: 35px;

  border-radius: 22px;

  box-shadow:
    0 12px 40px rgba(0,0,0,0.12);
}


.card h2,
.message-card h2 {
  text-align: center;

  color: #087cff;

  margin-bottom: 25px;

  font-size: 30px;
}


.card p {
  text-align: center;

  font-size: 20px;

  line-height: 1.8;
}


/* CONTACT */

.contact-item {
  margin: 20px 0;

  padding: 20px;

  border-radius: 14px;

  background: #f1f7ff;

  border-left: 5px solid #087cff;
}


.contact-item span {
  display: block;

  font-weight: bold;

  margin-bottom: 8px;
}


.contact-item a {
  color: #087cff;

  font-size: 18px;

  text-decoration: none;
}


/* MESSAGE */

.message-card label {
  display: block;

  margin-top: 17px;

  margin-bottom: 8px;

  font-weight: bold;
}


.message-card input,
.message-card textarea {
  width: 100%;

  padding: 14px;

  border: 1px solid #d7dce2;

  border-radius: 10px;

  outline: none;

  font-size: 16px;

  font-family: inherit;
}


.message-card input:focus,
.message-card textarea:focus {
  border-color: #087cff;

  box-shadow:
    0 0 0 3px rgba(8,124,255,0.10);
}


.message-card textarea {
  min-height: 140px;

  resize: vertical;
}


/* SEND */

.send-btn {
  width: 100%;

  margin-top: 22px;

  padding: 16px;

  border: none;

  border-radius: 11px;

  background: #087cff;

  color: white;

  font-size: 17px;

  font-weight: bold;

  cursor: pointer;

  transition: 0.3s;
}


.send-btn:hover {
  background: #005dcc;

  transform: translateY(-2px);
}


/* FOOTER */

footer {
  text-align: center;

  background: #101828;

  color: white;

  padding: 38px 15px;
}


.follow-box {
  margin-bottom: 25px;
}


.follow-box button {
  background: orange;

  border: none;

  padding: 13px 38px;

  border-radius: 9px;

  color: white;

  font-size: 17px;

  font-weight: bold;

  cursor: pointer;
}


footer p {
  margin: 9px;
}


.copyright {
  margin-top: 22px !important;

  opacity: 0.8;
}


/* MOBILE */

@media (max-width: 600px) {

  header {
    padding: 15px 4%;
  }

  .logo {
    font-size: 19px;
  }

  .page {
    padding: 50px 15px;
  }

  .card,
  .message-card {
    padding: 25px 18px;
  }

  .welcome-box h1 {
    font-size: 45px;

    letter-spacing: 1px;
  }

  .welcome-box p {
    font-size: 17px;
  }

}


/* LARGE COMPUTER */

@media (min-width: 1200px) {

  .welcome-box h1 {
    font-size: 100px;
  }

  }
